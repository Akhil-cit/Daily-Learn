<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash / Entry -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.daily_learn.ui.onboarding.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Onboarding -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.daily_learn.ui.onboarding.OnboardingFragment"
        android:label="Get Started"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ===== BOTTOM NAV DESTINATIONS ===== -->

    <!-- Home -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.daily_learn.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_learning"
            app:destination="@id/learningSessionFragment" />
        <action
            android:id="@+id/action_home_to_subjects"
            app:destination="@id/nav_subjects" />
        <action
            android:id="@+id/action_home_to_analyzer"
            app:destination="@id/syllabusAnalysisFragment" />
    </fragment>

    <!-- Plan -->
    <fragment
        android:id="@+id/nav_plan"
        android:name="com.example.daily_learn.ui.plan.PlanFragment"
        android:label="Plan"
        tools:layout="@layout/fragment_plan" />

    <!-- Subjects -->
    <fragment
        android:id="@+id/nav_subjects"
        android:name="com.example.daily_learn.ui.subjects.SubjectsFragment"
        android:label="Subjects"
        tools:layout="@layout/fragment_subjects">
        <action
            android:id="@+id/action_subjects_to_detail"
            app:destination="@id/subjectDetailFragment" />
        <action
            android:id="@+id/action_subjects_to_upload"
            app:destination="@id/syllabusAnalysisFragment" />
        <action
            android:id="@+id/action_subjects_to_editor"
            app:destination="@id/manualEditorFragment" />
        <action
            android:id="@+id/action_subjects_to_analyzer"
            app:destination="@id/syllabusAnalysisFragment" />
    </fragment>

    <!-- Progress -->
    <fragment
        android:id="@+id/nav_progress"
        android:name="com.example.daily_learn.ui.progress.ProgressFragment"
        android:label="Progress"
        tools:layout="@layout/fragment_progress" />

    <!-- Profile -->
    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.daily_learn.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ===== SUB-DESTINATIONS ===== -->

    <!-- AI Syllabus Analyzer (AI Syllabus -> Daily Topics) -->
    <fragment
        android:id="@+id/syllabusAnalysisFragment"
        android:name="com.example.daily_learn.ui.upload.SyllabusAnalysisFragment"
        android:label="AI Syllabus Analyzer"
        tools:layout="@layout/fragment_syllabus_analyzer">
        <action
            android:id="@+id/action_analyzer_to_home"
            app:destination="@id/nav_home" />
        <action
            android:id="@+id/action_analyzer_to_learning"
            app:destination="@id/learningSessionFragment" />
    </fragment>

    <!-- Subject Detail -->
    <fragment
        android:id="@+id/subjectDetailFragment"
        android:name="com.example.daily_learn.ui.subjects.SubjectDetailFragment"
        android:label="Subject Detail"
        tools:layout="@layout/fragment_subject_detail">
        <argument
            android:name="subjectId"
            app:argType="long" />
        <action
            android:id="@+id/action_detail_to_editor"
            app:destination="@id/manualEditorFragment" />
        <action
            android:id="@+id/action_detail_to_learning"
            app:destination="@id/learningSessionFragment" />
    </fragment>

    <!-- Manual Editor -->
    <fragment
        android:id="@+id/manualEditorFragment"
        android:name="com.example.daily_learn.ui.subjects.ManualEditorFragment"
        android:label="Edit Syllabus"
        tools:layout="@layout/fragment_manual_editor">
        <argument
            android:name="subjectId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!-- Syllabus Upload -->
    <fragment
        android:id="@+id/syllabusUploadFragment"
        android:name="com.example.daily_learn.ui.upload.SyllabusUploadFragment"
        android:label="Upload Syllabus"
        tools:layout="@layout/fragment_syllabus_upload">
        <action
            android:id="@+id/action_upload_to_editor"
            app:destination="@id/manualEditorFragment" />
    </fragment>

    <!-- Learning Session -->
    <fragment
        android:id="@+id/learningSessionFragment"
        android:name="com.example.daily_learn.ui.learning.LearningSessionFragment"
        android:label="Learning Session"
        tools:layout="@layout/fragment_learning_session">
        <argument
            android:name="topicId"
            app:argType="long" />
        <argument
            android:name="sessionId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_learning_to_quiz"
            app:destination="@id/quizFragment" />
    </fragment>

    <!-- Quiz -->
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.example.daily_learn.ui.learning.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">
        <argument
            android:name="topicId"
            app:argType="long" />
        <action
            android:id="@+id/action_quiz_to_result"
            app:destination="@id/quizResultFragment" />
    </fragment>

    <!-- Quiz Result -->
    <fragment
        android:id="@+id/quizResultFragment"
        android:name="com.example.daily_learn.ui.learning.QuizResultFragment"
        android:label="Quiz Result"
        tools:layout="@layout/fragment_quiz_result">
        <argument
            android:name="score"
            app:argType="integer" />
        <argument
            android:name="total"
            app:argType="integer" />
        <argument
            android:name="topicId"
            app:argType="long" />
        <action
            android:id="@+id/action_result_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
