<?xml version="1.0" encoding="utf-8"?>
<!-- item_upcoming_topic.xml — Upcoming topic row -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <View
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:background="@color/colorPrimary"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_upcoming_topic_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doubly Linked List"
            android:textSize="14sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_upcoming_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Structures"
            android:textSize="12sp"
            android:textColor="@color/textHint" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_upcoming_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 min"
        android:textSize="12sp"
        android:textColor="@color/textHint" />
</LinearLayout>
