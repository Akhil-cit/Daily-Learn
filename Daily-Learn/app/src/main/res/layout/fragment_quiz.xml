<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_quiz"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:title="Quick Quiz"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_back" />

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/pb_quiz_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressDrawable="@drawable/progress_bar_primary"
        android:progress="0"
        android:max="100" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Question counter -->
            <TextView
                android:id="@+id/tv_question_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question 1 of 5"
                android:textSize="13sp"
                android:textColor="@color/textHint"
                android:layout_marginBottom="16dp" />

            <!-- Question text card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorCard">

                <TextView
                    android:id="@+id/tv_question_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Question text goes here?"
                    android:textSize="18sp"
                    android:textColor="@color/textPrimary"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.4" />
            </androidx.cardview.widget.CardView>

            <!-- Options -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Option A"
                android:textSize="14sp"
                android:padding="16dp"
                android:gravity="start|center_vertical"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Option B"
                android:textSize="14sp"
                android:padding="16dp"
                android:gravity="start|center_vertical"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Option C"
                android:textSize="14sp"
                android:padding="16dp"
                android:gravity="start|center_vertical"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Option D"
                android:textSize="14sp"
                android:padding="16dp"
                android:gravity="start|center_vertical"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPrimary" />

            <!-- Feedback message -->
            <TextView
                android:id="@+id/tv_answer_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textSize="15sp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <!-- Next / Finish button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_question"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Next Question →"
                android:textSize="15sp"
                android:backgroundTint="@color/colorPrimary"
                app:cornerRadius="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
