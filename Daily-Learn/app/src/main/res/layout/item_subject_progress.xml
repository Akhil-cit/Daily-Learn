<?xml version="1.0" encoding="utf-8"?>
<!-- item_subject_progress.xml — Subject progress row in Progress tab -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/colorCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_sp_subject_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Data Structures"
                android:textSize="15sp"
                android:textColor="@color/textPrimary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_sp_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25%"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_sp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressDrawable="@drawable/progress_bar_primary"
            android:progress="25"
            android:max="100"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_sp_topics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 / 12 topics"
            android:textSize="12sp"
            android:textColor="@color/textHint" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
